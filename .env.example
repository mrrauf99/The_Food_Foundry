# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# Public site URL, used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.thefoodfoundry.com

# --- Not wired up yet ---------------------------------------------------
# The contact form (src/actions/contact.ts) and newsletter signup
# (src/actions/newsletter.ts) currently validate input and return success
# without sending anything. Add your email provider's key here and send the
# message from those two files.
#
# RESEND_API_KEY=
# CONTACT_FORM_TO_EMAIL=team@thefoodfoundry.com
